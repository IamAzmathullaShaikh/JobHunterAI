# ==============================================================================
# JobHunterAI Enterprise Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your secrets.
# Do not commit your .env file to version control.

# --- Core System Settings ---
ENVIRONMENT=development
PORT=8000
DEBUG=True
LOG_DIR=logs
DATABASE_URL=sqlite+aiosqlite:///./jobhunter.db

# --- AI Provider Configuration ---
# Options: groq, gemini, openai, openrouter, ollama, auto
AI_PROVIDER=auto

# Dynamic Routing Configuration (Used when AI_PROVIDER='auto')
DEFAULT_AI_PROVIDER=groq
FALLBACK_AI_PROVIDER=gemini
LOCAL_AI_PROVIDER=ollama

# Groq (Primary Tier 1)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Tier 2)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# OpenRouter (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Ollama (Local Fallback)
OLLAMA_HOST=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# --- Scraper Configuration ---
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_ACTOR_ID=apify/google-jobs-scraper

# Hunter.io (Recruiter Enrichment)
HUNTER_API_KEY=your_hunter_api_key_here

# --- Security & CORS ---
# Allowed CORS origins. Supports comma-separated list or JSON array.
# Use '*' for development only. Production requires explicit domains.
CORS_ORIGINS=*

# --- Matching & ATS Intelligence ---
MATCHING_CONFIG_VERSION=1.0.0
# MATCHING_WEIGHTS can be provided as a JSON string if customization is needed.
# MATCHING_WEIGHTS='{"skills": 0.35, "experience": 0.25, "education": 0.10, "keywords": 0.15, "location": 0.10, "salary": 0.05}'
